# Utilise pour "npm run build:ios" : l'app native n'est pas servie depuis le
# meme domaine que l'API (elle tourne dans une WebView locale), il faut donc
# une URL absolue vers le backend deploye.
#
# Copier ce fichier en ".env.capacitor" et renseigner l'URL reelle :
VITE_API_URL=https://restolab-web.onrender.com
