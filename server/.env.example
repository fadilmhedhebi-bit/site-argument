# RestoLab - Variables d'environnement

# PostgreSQL - URL de connexion à la base de données
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/restolab

# Secret pour la signature des tokens JWT (changer en production !)
JWT_SECRET=restolab-dev-secret-key-change-in-production

# Port du serveur backend
PORT=3001

# URL publique de l'application (pour les liens dans les emails)
APP_URL=http://localhost:5173

# Envoi d'email via l'API HTTP de Brevo (optionnel - sans config, les emails
# sont affichés dans la console). On utilise l'API REST plutôt que SMTP car
# les plateformes cloud comme Render bloquent les connexions SMTP sortantes.
# Cle API : Brevo -> Parametres -> SMTP & API -> onglet API Keys
# BREVO_API_KEY=xkeysib-...
# SMTP_FROM_EMAIL=noreply@restolab.app
# SMTP_FROM_NAME=RestoLab

# Facturation Stripe (abonnement des commerces) - sans ces variables, les
# routes /api/billing/checkout et /portal renvoient une erreur 503 mais le
# reste de l'app fonctionne normalement
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PRICE_STARTER=price_...
# STRIPE_PRICE_STANDARD=price_...
# STRIPE_PRICE_PREMIUM=price_...
# STRIPE_PRICE_EQUIPMENT=price_...
# STRIPE_WEBHOOK_SECRET=whsec_...
