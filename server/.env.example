# RestoLab - Variables d'environnement

# PostgreSQL - URL de connexion à la base de données
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/restolab

# Secret pour la signature des tokens JWT (changer en production !)
JWT_SECRET=restolab-dev-secret-key-change-in-production

# Port du serveur backend
PORT=3001

# URL publique de l'application (pour les liens dans les emails)
APP_URL=http://localhost:5173

# Configuration SMTP (optionnel - sans config, les emails sont affichés dans la console)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@example.com
# SMTP_PASS=your-password
# SMTP_FROM=RestoLab <noreply@restolab.app>
